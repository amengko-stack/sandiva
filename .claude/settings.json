{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-related-tests.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.development)",
      "Edit(./**/.env.production)",
      "Write(./**/.env)",
      "Write(./**/.env.local)",
      "Write(./**/.env.development)",
      "Write(./**/.env.production)"
    ],
    "allow": [
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npm test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
