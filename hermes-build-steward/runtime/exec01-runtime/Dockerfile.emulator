ARG SOURCE_DATE_EPOCH=1704067200
ARG BUILD_IMAGE
ARG RUNTIME_IMAGE
FROM ${BUILD_IMAGE} AS build
ARG SOURCE_DATE_EPOCH
WORKDIR /src
COPY go.mod main.go sandbox_linux.go sandbox_other.go ./
COPY emulator ./emulator
COPY actionexec ./actionexec
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -buildid=" -o /out/exec01-runtime . \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -buildid=" -o /out/exec01-action-exec ./actionexec \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -buildid=" -o /out/provider-emulator ./emulator/main.go \
 && cp /out/provider-emulator /out/codex \
 && mv /out/provider-emulator /out/claude \
 && touch -d "@${SOURCE_DATE_EPOCH}" /out /out/exec01-runtime /out/exec01-action-exec /out/codex /out/claude

FROM ${RUNTIME_IMAGE}
ARG SOURCE_DATE_EPOCH
RUN mkdir -p /opt/sandiva/bin \
 && touch -d "@${SOURCE_DATE_EPOCH}" /opt /opt/sandiva /opt/sandiva/bin
COPY --from=build --chmod=0555 /out/ /opt/sandiva/bin/
COPY --chmod=0444 policy/ /opt/sandiva/
USER 65532:65532
ENTRYPOINT ["/opt/sandiva/bin/exec01-runtime"]
