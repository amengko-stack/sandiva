ARG SOURCE_DATE_EPOCH=1704067200
ARG BUILD_IMAGE
ARG RUNTIME_IMAGE
FROM ${BUILD_IMAGE} AS build
WORKDIR /src
COPY go.mod main.go ./
COPY emulator ./emulator
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -buildid=" -o /out/exec01-runtime ./main.go \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -buildid=" -o /out/provider-emulator ./emulator/main.go

FROM ${RUNTIME_IMAGE}
COPY --from=build --chmod=0555 /out/exec01-runtime /opt/sandiva/bin/exec01-runtime
COPY --from=build --chmod=0555 /out/provider-emulator /opt/sandiva/bin/codex
COPY --from=build --chmod=0555 /out/provider-emulator /opt/sandiva/bin/claude
USER 65532:65532
ENTRYPOINT ["/opt/sandiva/bin/exec01-runtime"]
