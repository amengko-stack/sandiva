{
  "permissions": {
    "allow": ["mcp__sandiva_execution_authority__sandiva_execute"],
    "deny": ["Bash", "Read", "Write", "Edit", "Glob", "Grep", "LS", "NotebookEdit", "WebFetch", "WebSearch"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|Glob|Grep|LS|NotebookEdit|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/sandiva/bin/exec01-runtime authorize claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
