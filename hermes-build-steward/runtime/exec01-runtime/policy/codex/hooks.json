{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|Glob|Grep|LS|apply_patch|WebFetch|WebSearch|CodeMode",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/sandiva/bin/exec01-runtime authorize codex",
            "timeout": 5,
            "statusMessage": "Enforcing task-bound EXEC-01 tool policy"
          }
        ]
      }
    ]
  }
}
