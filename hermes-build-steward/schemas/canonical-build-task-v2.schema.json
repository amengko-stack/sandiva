{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandiva.example/schemas/canonical-build-task-v2.schema.json",
  "title": "Canonical Build Task v2 Dispatch Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "taskId", "taskVersion", "originatingPmInstructionRef",
    "originatingPmInstructionFingerprint", "specificationRef", "specificationVersion",
    "specificationHash", "acceptanceContractRef", "acceptanceContractVersion",
    "acceptanceContractHash", "repository", "baseRef", "scope", "acceptanceCriteria",
    "criterionEvidencePolicy", "permittedRepositoryAreas", "prohibitedRepositoryAreas",
    "riskLevel", "executorPolicy", "dispatchPolicy", "executionStatus", "branchRef",
    "prRef", "commitRefs", "evaluationRequirements", "qaRequirements",
    "partnerGateStatus", "retryPolicy", "attemptCount", "failureHistory",
    "permissionEnvelopeRef", "provenance", "auditMetadata", "createdAt", "updatedAt"
  ],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "taskId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "taskVersion": {"type": "integer", "minimum": 1},
    "originatingPmInstructionRef": {"type": "string", "minLength": 1},
    "originatingPmInstructionFingerprint": {"$ref": "#/$defs/sha256"},
    "specificationRef": {"type": "string", "minLength": 1},
    "specificationVersion": {"type": "string", "minLength": 1},
    "specificationHash": {"$ref": "#/$defs/sha256"},
    "acceptanceContractRef": {"type": "string", "minLength": 1},
    "acceptanceContractVersion": {"type": "string", "minLength": 1},
    "acceptanceContractHash": {"$ref": "#/$defs/sha256"},
    "repository": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"},
    "baseRef": {"$ref": "#/$defs/commit"},
    "scope": {"$ref": "#/$defs/nonEmptyStrings"},
    "acceptanceCriteria": {"$ref": "#/$defs/nonEmptyStrings"},
    "criterionEvidencePolicy": {"type": "object", "minProperties": 1},
    "permittedRepositoryAreas": {"$ref": "#/$defs/nonEmptyStrings"},
    "prohibitedRepositoryAreas": {"$ref": "#/$defs/nonEmptyStrings"},
    "riskLevel": {"type": "string", "minLength": 1},
    "executorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automaticDispatch", "approvedCommands"],
      "properties": {
        "automaticDispatch": {"const": true},
        "approvedCommands": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "dispatchPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "executorProfile", "permittedFallbackProfiles", "fallbackMode",
        "noDowngrade", "networkPolicyRef", "resourcePolicyRef", "publisherPolicyRef",
        "auditProvenanceId"
      ],
      "properties": {
        "mode": {"const": "AUTOMATIC"},
        "executorProfile": {"$ref": "#/$defs/profileRef"},
        "permittedFallbackProfiles": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/profileRef"}
        },
        "fallbackMode": {"enum": ["NONE", "ORDERED"]},
        "noDowngrade": {"const": true},
        "networkPolicyRef": {"type": "string", "minLength": 1},
        "resourcePolicyRef": {"type": "string", "minLength": 1},
        "publisherPolicyRef": {"type": "string", "minLength": 1},
        "auditProvenanceId": {"type": "string", "minLength": 1}
      }
    },
    "executionStatus": {"const": "CREATED"},
    "branchRef": {"type": ["string", "null"]},
    "prRef": {"type": ["string", "null"]},
    "commitRefs": {"type": "array", "items": {"$ref": "#/$defs/commit"}},
    "evaluationRequirements": {"$ref": "#/$defs/nonEmptyStrings"},
    "qaRequirements": {"$ref": "#/$defs/nonEmptyStrings"},
    "partnerGateStatus": {"type": "string", "minLength": 1},
    "retryPolicy": {
      "type": "object", "required": ["maxAttempts"],
      "properties": {"maxAttempts": {"type": "integer", "minimum": 1, "maximum": 3}},
      "additionalProperties": true
    },
    "attemptCount": {"const": 0},
    "failureHistory": {"type": "array"},
    "permissionEnvelopeRef": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"},
    "auditMetadata": {"type": "object"},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nonEmptyStrings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "profileRef": {
      "type": "object", "additionalProperties": false,
      "required": ["profileId", "profileFingerprint"],
      "properties": {
        "profileId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
        "profileFingerprint": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
