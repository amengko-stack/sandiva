{
  "git": {
    "deploymentEnabled": {
      "codex/h9-narrative-completeness": false,
      "codex/h12-findings-concurrency": false
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/cleanup-sessions",
      "schedule": "0 17 * * *"
    }
  ]
}
