# Postgres (Neon) — pooled connection string
DATABASE_URL=

# Random secret keying signed session tokens (rotate to invalidate all sessions)
APP_SESSION_TOKEN=

# Secret required by /api/cron/* routes (set the same value in Vercel Cron)
CRON_SECRET=

# Resend (weekly reminder email)
RESEND_API_KEY=
EMAIL_FROM="Sandiva Timesheets <timesheets@legal.sandiva.co>"

# Anthropic (Ask-AI dashboards, partner/admin only)
ANTHROPIC_API_KEY=

# Absolute base URL of the deployment (used for the Entra redirect URI and emailed links)
APP_BASE_URL=http://localhost:3100

# Microsoft Entra ID (single-tenant app registration) — sign-in is Entra-only,
# no local passwords. Redirect URI registered in Entra must be
# ${APP_BASE_URL}/api/auth/entra/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
